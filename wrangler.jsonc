{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "grito-web",
	"compatibility_date": "2025-08-15",
	"compatibility_flags": [
		// Enable Node.js API
		// see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
		"nodejs_compat",
		// Allow to fetch URLs in your app
		// see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
		"global_fetch_strictly_public",
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
	},
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "cloudflare-payload-db",
			"database_id": "2441aab2-5f9e-4240-ab99-e1d5bcde15e8",
			"remote": true,
		},
		// OpenNext tag cache — tracks on-demand revalidation (revalidatePath /
		// revalidateTag from the admin publish hooks). Dedicated DB, kept apart
		// from the Payload D1 so sync:prod / verify-sync never touch it.
		// The `revalidations` table is auto-created at deploy by populateCache.
		// database_id is filled in by `wrangler d1 create grito-web-next-tag-cache`.
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "grito-web-next-tag-cache",
			"database_id": "REPLACE_WITH_D1_CREATE_OUTPUT",
		},
	],
	"services": [
		// The service should match the "name" of your worker
		// {
		//   "binding": "WORKER_SELF_REFERENCE",
		//   "service": "my-app"
		// },
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "cloudflare-payload-r2",
			// Permite que ferramentas com remoteBindings (ex.: `pnpm sync:local`) acessem
			// o bucket remoto. Não afeta `pnpm dev`/build, que usam remoteBindings:false.
			"remote": true,
		},
 
		// OpenNext incremental cache — stores rendered ISR pages. Dedicated bucket,
		// kept apart from the Payload media R2 so sync:prod / sync:local never see it.
		// Create it with `wrangler r2 bucket create grito-web-next-cache`.
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "grito-web-next-cache",
		},
	],
	// Here's how to configure an additional environment
	// It can be deployed with `CLOUDFLARE_ENV=staging pnpm run deploy`
	// "env": {
	//   "staging": {
	//     "name": "my-app-staging",
	//     "d1_databases": [
	//       {
	//         "binding": "D1",
	//         "database_id": "DATABASE_ID",
	//         "database_name": "my-app-staging",
	//         "remote": true
	//       }
	//     ],
	//     "services": [
	//       // The service should match the "name" of your worker
	//       // {
	//       //   "binding": "WORKER_SELF_REFERENCE",
	//       //   "service": "my-app-staging"
	//       // },
	//     ],
	//     "r2_buckets": [
	//       {
	//         "binding": "R2",
	//         "bucket_name": "my-app-staging"
	//       }
	//       // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
	//       // {
	//       //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
	//       //   "bucket_name": "<BUCKET_NAME>",
	//       // },
	//     ]
	//   }
	// }
}